  L.push('Stock: ' + esc(meta.stockTitle) + ' | Online sales ' + dm(plan.start14) + '-' + dm(plan.end) + ' (' +
    Object.keys(plan.cov14).sort().map(function (p) { return p + ' ' + plan.cov14[p] + '/14 days'; }).join(', ') + ')');
  L.push('');
