# Copy to .env (or set in your hosting dashboard) and fill in.
TP_TIMEZONE=Asia/Kuala_Lumpur
TP_ADMIN_PASSWORD=choose-a-password       # protects the manager pages
TP_SECRET_KEY=any-long-random-string
TP_PUBLIC_URL=https://your-server.example.com   # used in streamers' personal links

# Monitoring rules
TP_CHECK_INTERVAL_SECONDS=120   # how often each live shift is checked
TP_GRACE_MINUTES=5              # allowed lateness
TP_NO_SHOW_MINUTES=20           # still not live after this = no-show (urgent)
TP_DROP_CHECKS=2                # offline this many checks in a row = "went offline"
TP_EARLY_END_MINUTES=10         # stopped this early before end = "ended early"

# Where alerts go (set at least one)
TP_TELEGRAM_BOT_TOKEN=
TP_TELEGRAM_CHAT_ID=
TP_DISCORD_WEBHOOK_URL=
TP_WEBHOOK_URL=

# Optional platform credentials
TP_TWITCH_CLIENT_ID=
TP_TWITCH_CLIENT_SECRET=
TP_YOUTUBE_API_KEY=
